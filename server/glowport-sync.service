# Glowport sync server as a service. Guide: docs/sync-server.md
# Put it at /etc/systemd/system/glowport-sync.service

[Unit]
Description=Glowport Sync-Server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/glowport-sync serve
User=glowport-sync
Group=glowport-sync
# Creates /var/lib/glowport-sync; only the service may access it.
StateDirectory=glowport-sync
StateDirectoryMode=0700
Environment=GLOWPORT_SYNC_DATA=/var/lib/glowport-sync

# Behind a web server (NGINX, Caddy) on the same machine that handles TLS:
Environment=GLOWPORT_SYNC_LISTEN=127.0.0.1:8787
Environment=GLOWPORT_SYNC_TRUST_PROXY=1

# The web server runs on another machine or container: listen on all addresses instead and
# only believe the web server about the sender (enter its internal address). `install.sh` enters this
# by itself with PROXY=<address>.
#Environment=GLOWPORT_SYNC_LISTEN=0.0.0.0:8787
#Environment=GLOWPORT_SYNC_TRUST_PROXY=10.0.0.10

# Without a web server in front, with its own certificate: instead
#Environment=GLOWPORT_SYNC_LISTEN=0.0.0.0:443
#Environment=GLOWPORT_SYNC_TLS_CERT=/var/lib/glowport-sync/tls/fullchain.pem
#Environment=GLOWPORT_SYNC_TLS_KEY=/var/lib/glowport-sync/tls/privkey.pem
#AmbientCapabilities=CAP_NET_BIND_SERVICE

Restart=on-failure
RestartSec=3

# The service needs nothing from the rest of the system.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
