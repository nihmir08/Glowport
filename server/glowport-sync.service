# Glowport Sync-Server als Dienst. Anleitung: docs/sync-server.md
# Ablegen als /etc/systemd/system/glowport-sync.service

[Unit]
Description=Glowport Sync-Server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/glowport-sync serve
User=glowport-sync
Group=glowport-sync
# Legt /var/lib/glowport-sync an; nur der Dienst darf hinein.
StateDirectory=glowport-sync
StateDirectoryMode=0700
Environment=GLOWPORT_SYNC_DATA=/var/lib/glowport-sync

# Hinter einem Webserver (NGINX, Caddy) auf demselben Rechner, der TLS übernimmt:
Environment=GLOWPORT_SYNC_LISTEN=127.0.0.1:8787
Environment=GLOWPORT_SYNC_TRUST_PROXY=1

# Der Webserver läuft auf einem anderen Rechner oder Container: stattdessen auf allen Adressen hören und
# den Absender nur dem Webserver glauben (seine innere Adresse eintragen). `install.sh` trägt das mit
# PROXY=<Adresse> von selbst ein.
#Environment=GLOWPORT_SYNC_LISTEN=0.0.0.0:8787
#Environment=GLOWPORT_SYNC_TRUST_PROXY=10.0.0.10

# Ohne Webserver davor, mit eigenem Zertifikat: stattdessen
#Environment=GLOWPORT_SYNC_LISTEN=0.0.0.0:443
#Environment=GLOWPORT_SYNC_TLS_CERT=/var/lib/glowport-sync/tls/fullchain.pem
#Environment=GLOWPORT_SYNC_TLS_KEY=/var/lib/glowport-sync/tls/privkey.pem
#AmbientCapabilities=CAP_NET_BIND_SERVICE

Restart=on-failure
RestartSec=3

# Der Dienst braucht nichts vom übrigen System.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
